        {
          "key": "botany_material.cultivar",
          "group": "botany_material",
          "attribute": "SPEC-TT-FIELD-BOTANY-MATERIAL-CULTIVAR",
          "type": "CustomMarkdownText",
          "sourcePath": "post.botany-material",
          "value": "Several varieties of tea bush *Camellia sinensis* var. *sinensis* are used for producing Xi Hu Longjing:"
        },
        {
          "key": "botany_material.pluck_standard",
          "group": "botany_material",
          "attribute": "SPEC-TT-FIELD-BOTANY-MATERIAL-PLUCK-STANDARD",
          "type": "CustomMarkdownText",
          "sourcePath": "post.botany-material",
          "value": "Traditionally picked one bud and one-two upper leaves (一芽一叶, yī yá yī yè or 一芽二叶, yī yá èr yè). For highest grades — only bud with one barely unfolded leaf, or exclusively buds."
        },
        {
          "key": "botany_material.raw_material",
          "group": "botany_material",
          "attribute": "SPEC-TT-FIELD-BOTANY-MATERIAL-RAW-MATERIAL",
          "type": "CustomMarkdownText",
          "sourcePath": "post.botany-material",
          "value": "Highest. Only tender, undamaged buds and leaves of uniform size are used, without coarse leaves, stems and impurities. Freshly picked raw material must be processed on the same day."
        },
        {
          "key": "brewing.tea_amount",
          "group": "brewing",
          "attribute": "SPEC-TT-FIELD-BREWING-TEA-AMOUNT",
          "type": "CustomMarkdownText",
          "sourcePath": "post.brewing",
          "value": "3 g per 150 ml water."
        },
        {
          "key": "brewing.teaware",
          "group": "brewing",
          "attribute": "SPEC-TT-FIELD-BREWING-TEAWARE",
          "type": "CustomMarkdownText",
          "sourcePath": "post.brewing",
          "value": "Glass tumbler (玻璃杯, bōli bēi) — best option for observing \"dance\" of leaves in water. White porcelain gàiwǎn (白瓷盖碗, bái cí gàiwǎn) of 150 ml volume also suitable — allows more precise control of steeping time and better evaluation of aroma."
        },
        {
          "key": "chemistry.alkaloids",
          "group": "chemistry",
          "attribute": "SPEC-TT-FIELD-CHEMISTRY-ALKALOIDS",
          "type": "CustomMarkdownText",
          "sourcePath": "post.chemistry",
          "value": "Caffeine content — approximately 4.0–4.8% of dry mass (according to scientific publications — up to 4.81%, one of the highest indicators among Chinese green teas). Theobromine and theophylline are also present in smaller quantities."
        },
        {
          "key": "chemistry.minerals",
          "group": "chemistry",
          "attribute": "SPEC-TT-FIELD-CHEMISTRY-MINERALS",
          "type": "CustomMarkdownText",
          "sourcePath": "post.chemistry",
          "value": "Fluorine (promotes dental enamel protection), potassium, magnesium, zinc, iron, manganese, selenium."
        },
        {
          "key": "chemistry.vitamins",
          "group": "chemistry",
          "attribute": "SPEC-TT-FIELD-CHEMISTRY-VITAMINS",
          "type": "CustomMarkdownText",
          "sourcePath": "post.chemistry",
          "value": "Vitamin C — 100–300 mg per 100 g dry tea (in fresh leaf of \"one bud — one leaf\" standard — over 1%). B vitamins: B₁ (thiamine) — ≈0.5 mg/100 g, B₂ (riboflavin) — ≈1.5 mg/100 g, B₃ (pantothenic acid) — ≈1.8 mg/100 g, PP (nicotinic acid) — ≈6.5 mg/100 g. Also contains vitamin A, vitamin E, folic acid."
        },
        {
          "key": "organoleptic.liquor_aroma",
          "group": "organoleptic",
          "attribute": "SPEC-TT-FIELD-ORGANOLEPTIC-LIQUOR-AROMA",
          "type": "CustomMarkdownText",
          "sourcePath": "post.organoleptic",
          "value": "Clean, persistent, fresh. The same notes dominate — bean floral aroma, tender green sweetness, light chestnut roast. In tea from Shifeng zone — noticeable orchid nuance. Aroma unfolds gradually with each infusion."
        },
        {
          "key": "organoleptic.liquor_color",
          "group": "organoleptic",
          "attribute": "SPEC-TT-FIELD-ORGANOLEPTIC-LIQUOR-COLOR",
          "type": "CustomMarkdownText",
          "sourcePath": "post.organoleptic",
          "value": "Light green, clean and transparent, with tender yellowish-green shade (嫩绿明亮). In highest grade teas — crystal clear, \"alive.\""
        },
        {
          "key": "organoleptic.spent_leaves",
          "group": "organoleptic",
          "attribute": "SPEC-TT-FIELD-ORGANOLEPTIC-SPENT-LEAVES",
          "type": "CustomMarkdownText",
          "sourcePath": "post.organoleptic",
          "value": "Even, whole, elastic leaves and buds of light green color, preserving the form \"one bud — one leaf.\" Leaf tender, uniform, without damage."
        },
        {
