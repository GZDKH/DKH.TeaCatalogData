{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "profile": {
    "id": "tea",
    "version": "1.0.0",
    "target": {
      "service": "ProductCatalogService",
      "dataExchangeProfile": "products",
      "catalogCode": "CATALOG-CHINESE-TEA"
    },
    "identity": {
      "upsertKey": ["source.system", "source.externalId"],
      "targetProductCode": "product.code",
      "sourceRevision": "source.revision"
    },
    "files": {
      "specificationGroups": "02-specifications/specification_groups.json",
      "specificationAttributes": "02-specifications/specification_attributes.json",
      "specificationOptions": "02-specifications/specification_attribute_options.json",
      "products": "04-products/<category>/<product-code>.json"
    }
  },
  "groups": [
    {
      "key": "classification_origin",
      "targetCode": "SPEC-TT-GROUP-CLASSIFICATION-ORIGIN",
      "labels": {"en-US": "Classification and Origin", "ru-RU": "Классификация и происхождение"}
    },
    {
      "key": "atomic",
      "targetCode": "SPEC-TT-GROUP-ATOMIC",
      "labels": {"en-US": "Core Tea Facts", "ru-RU": "Основные свойства чая"}
    },
    {
      "key": "botany_material",
      "targetCode": "SPEC-TT-GROUP-BOTANY-MATERIAL",
      "labels": {"en-US": "Botany and Raw Material", "ru-RU": "Ботаника и сырьё"}
    },
    {
      "key": "terroir",
      "targetCode": "SPEC-TT-GROUP-TERROIR",
      "labels": {"en-US": "Terroir", "ru-RU": "Терруар"}
    },
    {
      "key": "production",
      "targetCode": "SPEC-TT-GROUP-PRODUCTION",
      "labels": {"en-US": "Production", "ru-RU": "Производство"}
    },
    {
      "key": "history_culture",
      "targetCode": "SPEC-TT-GROUP-HISTORY-CULTURE",
      "labels": {"en-US": "History and Culture", "ru-RU": "История и культура"}
    },
    {
      "key": "organoleptic",
      "targetCode": "SPEC-TT-GROUP-ORGANOLEPTIC",
      "labels": {"en-US": "Organoleptic Profile", "ru-RU": "Органолептический профиль"}
    },
    {
      "key": "sensory",
      "targetCode": "SPEC-TT-GROUP-SENSORY",
      "labels": {"en-US": "Sensory Intensity", "ru-RU": "Интенсивность вкуса"}
    },
    {
      "key": "chemistry",
      "targetCode": "SPEC-TT-GROUP-CHEMISTRY",
      "labels": {"en-US": "Chemical Composition", "ru-RU": "Химический состав"}
    },
    {
      "key": "enrichment",
      "targetCode": "SPEC-TT-GROUP-ENRICHMENT",
      "labels": {"en-US": "Enrichment", "ru-RU": "Дополнительные характеристики"}
    },
    {
      "key": "brewing",
      "targetCode": "SPEC-TT-GROUP-BREWING",
      "labels": {"en-US": "Brewing", "ru-RU": "Заваривание"}
    },
    {
      "key": "recipe",
      "targetCode": "SPEC-TT-GROUP-RECIPE",
      "labels": {"en-US": "Brewing Recipe", "ru-RU": "Рецепт заваривания"}
    },
    {
      "key": "harvest",
      "targetCode": "SPEC-TT-GROUP-HARVEST",
      "labels": {"en-US": "Harvest", "ru-RU": "Сбор урожая"}
    },
    {
      "key": "storage",
      "targetCode": "SPEC-TT-GROUP-STORAGE",
      "labels": {"en-US": "Storage", "ru-RU": "Хранение"}
    },
    {
      "key": "price_counterfeit",
      "targetCode": "SPEC-TT-GROUP-PRICE-COUNTERFEIT",
      "labels": {"en-US": "Price and Authenticity", "ru-RU": "Цена и подлинность"}
    },
    {
      "key": "facts",
      "targetCode": "SPEC-TT-GROUP-FACTS",
      "labels": {"en-US": "Facts", "ru-RU": "Факты"}
    },
    {
      "key": "comparison",
      "targetCode": "SPEC-TT-GROUP-COMPARISON",
      "labels": {"en-US": "Comparison", "ru-RU": "Сравнение"}
    },
    {
      "key": "health",
      "targetCode": "SPEC-TT-GROUP-HEALTH",
      "labels": {"en-US": "Health Notes", "ru-RU": "Заметки о пользе"}
    },
    {
      "key": "contraindications",
      "targetCode": "SPEC-TT-GROUP-CONTRAINDICATIONS",
      "labels": {"en-US": "Contraindications", "ru-RU": "Противопоказания"}
    },
    {
      "key": "conclusion",
      "targetCode": "SPEC-TT-GROUP-CONCLUSION",
      "labels": {"en-US": "Conclusion", "ru-RU": "Итог"}
    },
    {
      "key": "source",
      "targetCode": "SPEC-TT-GROUP-SOURCE",
      "labels": {"en-US": "Source Metadata", "ru-RU": "Метаданные источника"}
    }
  ],
  "attributes": [
    {
      "key": "classification_origin.tea_type",
      "group": "classification_origin",
      "targetCode": "SPEC-TT-CLASSIFICATION-ORIGIN-TEA-TYPE",
      "type": "Option",
      "sourcePaths": ["meta.tea_type"],
      "filterable": true
    },
    {
      "key": "source.category_code",
      "group": "source",
      "targetCode": "SPEC-TT-SOURCE-CATEGORY-CODE",
      "type": "CustomText",
      "sourcePaths": ["meta.category_code"],
      "showOnPage": false
    },
    {
      "key": "atomic.oxidation",
      "group": "atomic",
      "targetCode": "SPEC-TT-ATOMIC-OXIDATION",
      "type": "Range",
      "unit": "%",
      "sourcePaths": ["meta.oxidation_min", "meta.oxidation_max"]
    },
    {
      "key": "brewing.brew_temp",
      "group": "brewing",
      "targetCode": "SPEC-TT-BREWING-BREW-TEMP",
      "type": "Range",
      "unit": "°C",
      "sourcePaths": ["meta.brew_temp_min", "meta.brew_temp_max"]
    },
    {
      "key": "atomic.shape",
      "group": "atomic",
      "targetCode": "SPEC-TT-ATOMIC-SHAPE",
      "type": "Option",
      "sourcePaths": ["meta.shape", "sections.atomic.shape"],
      "filterable": true
    },
    {
      "key": "atomic.processing",
      "group": "atomic",
      "targetCode": "SPEC-TT-ATOMIC-PROCESSING",
      "type": "Option",
      "sourcePaths": ["meta.processing", "sections.atomic.processing"],
      "filterable": true
    },
    {
      "key": "atomic.roast_level",
      "group": "atomic",
      "targetCode": "SPEC-TT-ATOMIC-ROAST-LEVEL",
      "type": "Option",
      "sourcePaths": ["meta.roast_level", "sections.atomic.roast_level"],
      "filterable": true
    },
    {
      "key": "classification_origin.gi_status",
      "group": "classification_origin",
      "targetCode": "SPEC-TT-CLASSIFICATION-ORIGIN-GI-STATUS",
      "type": "Boolean",
      "sourcePaths": ["meta.gi_status"]
    },
    {
      "key": "classification_origin.gi_standard",
      "group": "classification_origin",
      "targetCode": "SPEC-TT-CLASSIFICATION-ORIGIN-GI-STANDARD",
      "type": "CustomText",
      "sourcePaths": ["meta.gi_standard"]
    },
    {
      "key": "organoleptic.taste",
      "group": "organoleptic",
      "targetCode": "SPEC-TT-FIELD-ORGANOLEPTIC-TASTE",
      "type": "CustomText",
      "sourcePaths": ["sections.organoleptic.taste", "sections.sensory.taste"]
    },
    {
      "key": "organoleptic.liquor_aroma",
      "group": "organoleptic",
      "targetCode": "SPEC-TT-FIELD-ORGANOLEPTIC-LIQUOR-AROMA",
      "type": "CustomText",
      "sourcePaths": ["sections.organoleptic.liquor_aroma"]
    },
    {
      "key": "organoleptic.dry_leaf_aroma",
      "group": "organoleptic",
      "targetCode": "SPEC-TT-FIELD-ORGANOLEPTIC-DRY-LEAF-AROMA",
      "type": "CustomText",
      "sourcePaths": ["sections.organoleptic.dry_leaf_aroma"]
    },
    {
      "key": "organoleptic.liquor_color",
      "group": "organoleptic",
      "targetCode": "SPEC-TT-FIELD-ORGANOLEPTIC-LIQUOR-COLOR",
      "type": "CustomText",
      "sourcePaths": ["sections.organoleptic.liquor_color"]
    },
    {
      "key": "organoleptic.spent_leaves",
      "group": "organoleptic",
      "targetCode": "SPEC-TT-FIELD-ORGANOLEPTIC-SPENT-LEAVES",
      "type": "CustomText",
      "sourcePaths": ["sections.organoleptic.spent_leaves"]
    },
    {
      "key": "enrichment.flavor_tags",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-FLAVOR-TAGS",
      "type": "List",
      "valueEncoding": "json-array-string",
      "sourcePaths": ["enrichment.flavor_tags"]
    },
    {
      "key": "enrichment.caffeine_level",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-CAFFEINE-LEVEL",
      "type": "Option",
      "sourcePaths": ["enrichment.caffeine_level"],
      "filterable": true
    },
    {
      "key": "enrichment.difficulty",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-DIFFICULTY",
      "type": "Option",
      "sourcePaths": ["enrichment.difficulty"],
      "filterable": true
    },
    {
      "key": "enrichment.price_tier",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-PRICE-TIER",
      "type": "Option",
      "sourcePaths": ["enrichment.price_tier"],
      "filterable": true
    },
    {
      "key": "enrichment.best_season",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-BEST-SEASON",
      "type": "List",
      "valueEncoding": "json-array-string",
      "sourcePaths": ["enrichment.best_season"]
    },
    {
      "key": "enrichment.occasion",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-OCCASION",
      "type": "List",
      "valueEncoding": "json-array-string",
      "sourcePaths": ["enrichment.occasion"]
    },
    {
      "key": "enrichment.food_pairings",
      "group": "enrichment",
      "targetCode": "SPEC-TT-ENRICHMENT-FOOD-PAIRINGS",
      "type": "List",
      "valueEncoding": "json-array-string",
      "sourcePaths": ["enrichment.food_pairings"]
    },
    {
      "key": "brewing.water_temp",
      "group": "brewing",
      "targetCode": "SPEC-TT-FIELD-BREWING-WATER-TEMP",
      "type": "Number",
      "unit": "°C",
      "sourcePaths": ["sections.brewing.water_temp"],
      "filterable": false
    },
    {
      "key": "source.version",
      "group": "source",
      "targetCode": "SPEC-TT-SOURCE-VERSION",
      "type": "CustomText",
      "sourcePaths": ["meta.version"],
      "showOnPage": false
    },
    {
      "key": "source.last_updated",
      "group": "source",
      "targetCode": "SPEC-TT-SOURCE-LAST-UPDATED",
      "type": "Date",
      "sourcePaths": ["meta.last_updated"],
      "showOnPage": false
    },
    {
      "key": "source.review_status",
      "group": "source",
      "targetCode": "SPEC-TT-SOURCE-REVIEW-STATUS",
      "type": "Option",
      "sourcePaths": ["meta.review_status"],
      "showOnPage": false
    }
  ],
  "attributePatterns": [
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_water_temp$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-{field}",
      "type": "Number",
      "unit": "°C",
      "sourcePaths": ["recipe[].{field}"],
      "filterable": false
    },
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_tea_grams$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-{field}",
      "type": "Number",
      "unit": "g",
      "sourcePaths": ["recipe[].{field}"],
      "filterable": false
    },
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_water_ml$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-{field}",
      "type": "Number",
      "unit": "ml",
      "sourcePaths": ["recipe[].{field}"],
      "filterable": false
    },
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_max_steeps$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-{field}",
      "type": "Number",
      "unit": "count",
      "sourcePaths": ["recipe[].{field}"],
      "filterable": false
    },
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_(steep_sec|increment_sec)$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-{field}",
      "type": "Duration",
      "unit": "s",
      "sourcePaths": ["recipe[].{field}"],
      "filterable": false
    },
    {
      "keyPattern": "^recipe\\.[a-z0-9-]+_rinse$",
      "group": "recipe",
      "targetCodePattern": "SPEC-TT-RECIPE-{style}-RINSE",
      "type": "Boolean",
      "sourcePaths": ["recipe[].rinse"],
      "filterable": false
    },
    {
      "keyPattern": "^harvest\\.[a-z0-9-]+_months$",
      "group": "harvest",
      "targetCodePattern": "SPEC-TT-HARVEST-{phase}-MONTHS",
      "type": "List",
      "valueEncoding": "json-array-string",
      "sourcePaths": ["harvest[].months"],
      "filterable": false
    }
  ],
  "rules": {
    "unknownAttribute": "error",
    "unknownGroup": "error",
    "missingValue": "omit-specification",
    "duplicateAttributePerProduct": "error",
    "sourceIdentity": "required-and-idempotent",
    "targetCodes": "stable-and-immutable",
    "explicitAttributesOverridePatterns": true,
    "productValueLimit": 4000,
    "validateBeforeApply": true,
    "applyMode": "dry-run-then-canary",
    "unmappedSourceField": "review-required",
    "markdownMapping": "explicit-narrative-field-only"
  }
}
